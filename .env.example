# ============================================
# Database Configuration
# ============================================

# PostgreSQL connection string (Neon Database)
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL=

# ============================================
# Application Configuration
# ============================================

# Base URL of the application (used for OAuth callbacks)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Authentication (better-auth + Keycloak SSO)
# ============================================

# Secret key for better-auth session encryption
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Keycloak SSO Configuration
# Your Keycloak server base URL (without realm path)
KEYCLOAK_URL=https://sso.example.com
# The realm configured for this application
KEYCLOAK_REALM=myrealm
# OAuth2 client ID configured in Keycloak
KEYCLOAK_CLIENT_ID=blog
# OAuth2 client secret from Keycloak
KEYCLOAK_CLIENT_SECRET=

# ============================================
# Content Editor
# ============================================

# TinyMCE Editor API Key
# Get free API key from: https://www.tiny.cloud/auth/signup/
NEXT_PUBLIC_TINYMCE_API_KEY=

# ============================================
# File Storage (AWS S3)
# ============================================

# AWS S3 Configuration for image uploads
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ============================================
# Search (Algolia)
# ============================================

NEXT_PUBLIC_ALGOLIA_SEARCH_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_ALGOLIA_SEARCH_INDEX_NAME=
ALGOLIA_ADMIN_API_KEY=

# ============================================
# Analytics & Monitoring
# ============================================

# Google Analytics 4 (GA4)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_KEY=

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=
