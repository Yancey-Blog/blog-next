# ============================================
# Database Configuration
# ============================================

# PostgreSQL connection string (Supabase)
# Format: postgres://postgres.[project-ref]:password@aws-x-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ============================================
# Application Configuration
# ============================================

# Base URL of the application (used for OAuth callbacks)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Disqus comments (optional) - your Disqus site "shortname".
# Defaults to "yancey-blog" in code if unset; override per-environment here.
NEXT_PUBLIC_DISQUS_SHORTNAME=yancey-blog

# ============================================
# Authentication & Authorization
# ============================================

# Secret key for better-auth session encryption
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated list of admin email addresses
# Only these emails can login via OAuth
ADMIN_EMAILS=admin@example.com,admin2@example.com

# Passkey (WebAuthn) login is also available for admins once signed in via
# OAuth - register one from /admin/management -> Passkeys. No env vars
# needed; the Relying Party ID is derived from NEXT_PUBLIC_APP_URL above.

# ============================================
# OAuth Providers
# ============================================

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Configuration
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# File Storage (AWS S3)
# ============================================

# AWS S3 Configuration for image uploads
# Get credentials from: https://console.aws.amazon.com/iam/
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ============================================
# Search (Algolia)
# ============================================

# Algolia Search Configuration
# Get credentials from: https://www.algolia.com/dashboard

# Application ID (public)
NEXT_PUBLIC_ALGOLIA_SEARCH_APP_ID=
ALGOLIA_APPLICATION_ID=

# Admin API Key (private, full access for indexing)
# WARNING: Keep this secret! Never expose in client-side code
ALGOLIA_ADMIN_API_KEY=

# ============================================
# Analytics & Monitoring
# ============================================

# Google Analytics 4 (GA4) - Direct integration
# Format: G-XXXXXXXXXX
# Get measurement ID from: https://analytics.google.com/
# Note: Universal Analytics (UA-XXXXX) is deprecated and no longer works
NEXT_PUBLIC_GA_KEY=

# Sentry Error Tracking
# Get DSN from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# PWA / Web Push (VAPID)
# ============================================

# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address the push service can reach you at if something's wrong.
# Format: mailto:you@example.com (or an https:// URL)
VAPID_SUBJECT=mailto:admin@example.com
